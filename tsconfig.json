{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@juiced/schema": ["../../packages/schema/src/index.ts"],
      "@juiced/scoring": ["../../packages/scoring/src/index.ts"],
      "@juiced/libraries": ["../../packages/libraries/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
