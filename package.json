  },
  "license": "MIT",
  "author": "Harshit Singh <harshit@halacarly.com>",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "juicedresume-mcp": "dist/index.js",
    "juiced-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
